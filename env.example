# --- Required -------------------------------------------------------------
# Long-lived user access token (60 days) with: instagram_basic,
# instagram_content_publish, instagram_manage_insights, instagram_manage_comments,
# pages_show_list, pages_read_engagement, business_management
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
# Instagram professional account ID (find it with the get_account_pages tool)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_user_id

# --- Optional -------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# Times like "2026-11-20T18:30" (no offset) are read in this zone
TIMEZONE=Europe/Paris

# Slot planner: posts per local day, real minutes between two publishes,
# local posting windows (no window may cross midnight) and random shift
# MAX_POSTS_PER_DAY=3
# MIN_SLOT_GAP_MINUTES=120
# POSTING_WINDOWS=11:00-13:00,17:00-21:00
# SLOT_JITTER_MINUTES=7

# Where the schedule, A/B labels and insight snapshots are stored
# (default: data/ig_campaign.db in the project folder, or in
# ~/.instagram-campaign-mcp for a non-editable install; IG_MCP_HOME overrides)
# DATABASE_PATH=./data/ig_campaign.db
# Asset files the website plays (served at /api/media)
# MEDIA_ROOT=./data/media
# Renders the worker runs at once (1: an 8 GB GPU froze with 2 Blender renders + the voice)
# RENDER_CONCURRENCY=1
# One heavy GPU job at a time (renders, the voice model): the machine-wide lock file, the
# same for every process; also read by the voice service (default ~/.ig-campaign/gpu.lock)
# GPU_LOCK_PATH=
# Resource guard (step 166): a render or the voice model starts only with this much free RAM
# (GB, 0: no check); nothing heavy for this many minutes after `up` starts; the watchdog
# pauses the studio's heavy jobs while RAM or the GPU temperature is critical
# GUARD_MIN_FREE_RAM_GB=8
# GUARD_STARTUP_GRACE_MIN=10
# GUARD_WATCHDOG=true
# Heat budget (step 171): a heavy job uses this share of the logical CPUs; the watchdog
# cools the machine at the GPU temperature (resume at the second), and for 3 min after this
# many minutes of continuous heavy work (0: no duty cycle). Log: data/logs/guard.log
# GUARD_CPU_SHARE=0.5
# GUARD_SUSPEND_TEMP_C=83
# GUARD_RESUME_TEMP_C=74
# GUARD_MAX_BUSY_MIN=15

# Winner rules: judged after N hours, needs this reach, and this many times
# the account's median engagement
WINNER_MIN_AGE_HOURS=48
WINNER_MIN_REACH=300
WINNER_THRESHOLD=1.5

# Evidence engine: matching matured Reels a learning with a tag predicate needs
# for medium / high confidence, and how far from the account median (1.0) its
# engagement index must be (a do needs > 1 + effect, a dont < 1 - effect)
# EVIDENCE_MIN_N_MEDIUM=5
# EVIDENCE_MIN_N_HIGH=15
# EVIDENCE_MIN_EFFECT=0.15

# Experiments (one variable, 2-4 variants) open at once; the explore ideas fill them
# MAX_OPEN_EXPERIMENTS=2

# Download images before publishing and reject what Meta would: non-JPEG
# files and feed images with a ratio outside 4:5 .. 1.91:1
VALIDATE_IMAGE_RATIO=true

# Client-side cap on Graph API calls; when reached, calls fail fast with a
# "next slot in N min" message instead of hanging
# RATE_LIMIT_REQUESTS_PER_HOUR=200

# Nightly database backups (`ig-campaign restore <file>` puts one back), how
# many are kept, and the age (days) past which a post keeps only its
# age-schedule insight snapshots and the latest
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14
# SNAPSHOT_THIN_AFTER_DAYS=45

# Voice-over: the local VoxCPM2 service (vendor/voxcpm_tts/README.md has the setup).
# Without these the videos have captions and no voice (TTS_PROVIDER=none).
# TTS_PROVIDER=http
# TTS_HTTP_URL=http://127.0.0.1:8766/tts
# TTS_HTTP_RESPONSE=json
# Default voice (brand/voices/voices.json): conteur_grave, coach_energique or douce_nuit
# TTS_VOICE=conteur_grave
# The service's venv python: `ig-campaign up` then starts and stops the service itself,
# and its model cache (HF_HOME, ~5 GB: put it on a disk with room)
# TTS_SERVER_PYTHON=D:\voice\vox\Scripts\python.exe
# TTS_SERVER_HF_HOME=D:\voice\hf
# Seconds the studio waits for one voice-over (requests queue behind the GPU)
# TTS_TIMEOUT_S=3600

# Stock clips from Pexels (free key: https://www.pexels.com/api/). Empty = the
# stock search is off and hidden on the website
PEXELS_API_KEY=

# Paid ads (Phase 9, owner step H6). Everything below except the token is also
# editable on the website (Settings > Ads); a value saved there wins over this file.
# The ad account id, digits only. The ads
# client reads with INSTAGRAM_ACCESS_TOKEN, which then also needs ads_read
# META_AD_ACCOUNT_ID=
# Budget caps in the ad account's currency, checked before anything can spend.
# 0 (the default) = no spend allowed. The daily cap may not exceed the lifetime cap
# ADS_DAILY_CAP=0
# ADS_TEST_CAP=0
# ADS_LIFETIME_CAP=0
# ADS_CURRENCY=EUR
# Promoting a post (always created paused): the Facebook Page linked to the Instagram
# account, the objective (OUTCOME_AWARENESS or OUTCOME_ENGAGEMENT), and the EU fields
# every ad set needs: who benefits from the ads and who pays for them
# META_PAGE_ID=
# ADS_OBJECTIVE=OUTCOME_AWARENESS
# ADS_DSA_BENEFICIARY=
# ADS_DSA_PAYOR=
# A/B tests: days a test runs before it is judged, and tests running at once
# ADS_TEST_DAYS=7
# ADS_MAX_RUNNING_TESTS=2

# Website password: required before `ig-campaign up --host 0.0.0.0` opens the studio
# to the home network (phone). Empty = this computer only.
# UI_PASSWORD=

LOG_LEVEL=INFO
