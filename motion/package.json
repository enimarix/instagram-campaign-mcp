{
  "name": "growth-studio-motion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "still": "node render.mjs --template Hello --props props/hello.json --out out/hello.png --still --frame 45",
    "test": "node --test",
    "still:preview": "node render.mjs --template Preview8bit --props props/preview8bit.json --out out/preview8bit.png --still --frame 220",
    "still:timeline": "node render.mjs --template TimelineDemo --props props/timeline-demo.json --out out/timeline-demo.png --still --frame 120",
    "still:factquest": "node render.mjs --template FactQuest --props props/factquest.json --out out/factquest.png --still --frame 160",
    "still:bossbattle": "node render.mjs --template BossBattle --props props/bossbattle.json --out out/bossbattle.png --still --frame 300",
    "still:quizchest": "node render.mjs --template QuizChest --props props/quizchest.json --out out/quizchest.png --still --frame 230",
    "still:dialogstory": "node render.mjs --template DialogStory --props props/dialogstory.json --out out/dialogstory.png --still --frame 150",
    "still:pixelskit": "node render.mjs --template PixelSkit --props props/pixelskit.json --out out/pixelskit.png --still --frame 240",
    "still:voxel": "node render.mjs --template VoxelPreview --props props/voxel-preview.json --out out/voxel.png --still --frame 150",
    "still:voxelquest": "node render.mjs --template VoxelQuest --props props/voxelquest.json --out out/voxelquest.png --still --frame 150",
    "still:paperstory": "node render.mjs --template PaperStory --props props/paperstory.json --out out/paperstory.png --still --frame 580",
    "still:endcard": "node render.mjs --template EndCard --props props/voxel-endcard.json --out out/endcard.png --still --frame 100",
    "still:endcards": "node render.mjs --template EndCard --props props/paper-endcard.json --out out/paper-endcard.png --still --frame 90 && node render.mjs --template EndCard --props props/clean-endcard.json --out out/clean-endcard.png --still --frame 90 && node render.mjs --template EndCard --props props/pixel-endcard.json --out out/pixel-endcard.png --still --frame 100",
    "check:voxel": "node scripts/check-determinism.mjs",
    "still:cutaway": "node render.mjs --template Cutaway --props props/cutaway.json --out out/cutaway.png --still --frame 560 && node render.mjs --template EndCard --props props/cutaway-endcard.json --out out/cutaway-endcard.png --still --frame 100",
    "still:editorial": "node render.mjs --template Editorial --props props/editorial.json --out out/editorial.png --still --frame 278 && node render.mjs --template EndCard --props props/editorial-endcard.json --out out/editorial-endcard.png --still --frame 90"
  },
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/bundler": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/fonts": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@remotion/three": "4.0.544",
    "esbuild": "0.28.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "three": "0.178.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/three": "0.178.1",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
