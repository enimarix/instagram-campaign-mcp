{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Today's quotas (learning.quotas.todays_quotas)",
  "type": "object",
  "required": ["date", "limits", "counts", "humour_target", "clips_available",
               "batch_size", "effective_batch_size", "styles"],
  "$defs": {
    "numbers": {"type": "object",
                "required": ["ideas", "explore", "humour", "informative", "reactions"],
                "properties": {"ideas": {"type": ["integer", "null"]}},
                "additionalProperties": {"type": "integer"}}
  },
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "limits": {"$ref": "#/$defs/numbers"},
    "counts": {"$ref": "#/$defs/numbers"},
    "humour_target": {"type": "integer"},
    "clips_available": {"type": "integer", "minimum": 0},
    "batch_size": {"type": "integer"},
    "effective_batch_size": {"type": ["integer", "null"]},
    "places": {"type": "object", "required": ["orders", "change_requests", "dm_picks", "ideas_left"],
               "additionalProperties": {"type": ["integer", "null"], "minimum": 0}},
    "styles": {"type": "object",
               "additionalProperties": {"type": "object", "required": ["count", "limit"],
                                        "properties": {"count": {"type": "integer"},
                                                       "limit": {"type": ["integer", "null"]}}}}
  }
}
