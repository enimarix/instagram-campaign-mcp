{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduled work orders, oldest first (studio.work_orders.for_agent): Reels the owner sent to make, from the Trending page (source trend) or by DM (source dm)",
  "type": "object",
  "required": ["untrusted_captions", "orders"],
  "additionalProperties": false,
  "properties": {
    "untrusted_captions": {"const": true},
    "orders": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "source", "source_id", "pick_id", "mode", "instruction", "status",
                     "permalink", "own_reel", "sender_username", "topic", "caption_quote",
                     "likes", "comments", "views", "created_at"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer"},
          "source": {"enum": ["trend", "dm"]},
          "source_id": {"type": ["integer", "null"]},
          "pick_id": {"type": ["integer", "null"]},
          "mode": {"enum": ["inspired", "react", "owner"]},
          "instruction": {"type": ["string", "null"], "maxLength": 500},
          "status": {"const": "scheduled"},
          "permalink": {"type": "string", "pattern": "^https://"},
          "own_reel": {"type": "boolean"},
          "sender_username": {"type": ["string", "null"]},
          "topic": {"type": ["string", "null"]},
          "caption_quote": {"type": ["string", "null"]},
          "likes": {"type": ["integer", "null"]},
          "comments": {"type": ["integer", "null"]},
          "views": {"type": ["integer", "null"]},
          "created_at": {"type": "string"},
          "skip_reason": {"type": "null"},
          "idea_id": {"type": "null"},
          "asset_id": {"type": "null"}
        }
      }
    }
  }
}
