{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New work orders, oldest first (studio.work_orders.for_agent): Trending Reels the owner sent to make",
  "type": "object",
  "required": ["untrusted_captions", "orders"],
  "additionalProperties": false,
  "properties": {
    "untrusted_captions": {"const": true},
    "orders": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "source_id", "mode", "instruction", "status", "permalink", "topic",
                     "caption_quote", "likes", "comments", "views", "created_at"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer"},
          "source_id": {"type": "integer"},
          "mode": {"enum": ["inspired", "react"]},
          "instruction": {"type": ["string", "null"], "maxLength": 500},
          "status": {"const": "new"},
          "permalink": {"type": "string", "pattern": "^https://"},
          "topic": {"type": ["string", "null"]},
          "caption_quote": {"type": ["string", "null"]},
          "likes": {"type": ["integer", "null"]},
          "comments": {"type": ["integer", "null"]},
          "views": {"type": ["integer", "null"]},
          "created_at": {"type": "string"},
          "skip_reason": {"type": "null"},
          "idea_id": {"type": "null"},
          "asset_id": {"type": "null"}
        }
      }
    }
  }
}
