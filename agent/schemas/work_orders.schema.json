{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduled work orders, oldest first (studio.work_orders.for_agent): videos the owner sent to make, from the Trending page (source trend), by DM (source dm), Créer une vidéo (source create) or même vidéo, autre style (source change: from_video); style: the style button pressed, null = Auto",
  "type": "object",
  "required": ["untrusted_captions", "orders"],
  "additionalProperties": false,
  "properties": {
    "untrusted_captions": {"const": true},
    "orders": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "source", "source_id", "pick_id", "mode", "style", "instruction", "status",
                     "permalink", "own_reel", "sender_username", "topic", "caption_quote",
                     "likes", "comments", "views", "created_at", "from_asset_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer"},
          "source": {"enum": ["trend", "dm", "create", "change"]},
          "source_id": {"type": ["integer", "null"]},
          "pick_id": {"type": ["integer", "null"]},
          "mode": {"enum": ["inspired", "react", "owner"]},
          "style": {"type": ["string", "null"]},
          "instruction": {"type": ["string", "null"], "maxLength": 500},
          "status": {"const": "scheduled"},
          "permalink": {"type": ["string", "null"], "pattern": "^https://"},
          "own_reel": {"type": "boolean"},
          "sender_username": {"type": ["string", "null"]},
          "topic": {"type": ["string", "null"]},
          "caption_quote": {"type": ["string", "null"]},
          "likes": {"type": ["integer", "null"]},
          "comments": {"type": ["integer", "null"]},
          "views": {"type": ["integer", "null"]},
          "created_at": {"type": "string"},
          "skip_reason": {"type": "null"},
          "idea_id": {"type": "null"},
          "asset_id": {"type": "null"},
          "from_asset_id": {"type": ["integer", "null"]},
          "from_video": {"type": "object",
                         "required": ["id", "hook", "script", "style", "template"]}
        }
      }
    }
  }
}
