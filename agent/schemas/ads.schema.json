{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ads for the weekly-ads run (ads.agent.work_packet): winners, presets, open tests, finished tests to learn from",
  "type": "object",
  "required": ["configured"],
  "$defs": {
    "test": {
      "type": "object",
      "required": ["id", "status", "hypothesis", "variable", "variants", "proposed_by",
                   "primary_metric", "evaluation"],
      "properties": {
        "id": {"type": "integer"},
        "status": {"enum": ["proposed", "approved", "running", "finished", "cancelled"]},
        "hypothesis": {"type": "string"},
        "variable": {"enum": ["creative", "audience", "placement"]},
        "variants": {"type": "array", "minItems": 2, "maxItems": 4},
        "proposed_by": {"enum": ["owner", "agent"]},
        "launched_by": {"enum": ["owner", "agent", null]},
        "primary_metric": {"type": "string"},
        "evaluation": {"type": "object"}
      }
    }
  },
  "if": {"properties": {"configured": {"const": true}}},
  "then": {
    "required": ["configured", "proposals_left", "winners", "open_tests", "to_learn"],
    "additionalProperties": false,
    "properties": {
      "configured": {"const": true},
      "proposals_left": {"type": "integer", "minimum": 0},
      "presets": {
        "type": "array",
        "maxItems": 10,
        "items": {"type": "object", "required": ["id", "label", "varies"],
                  "properties": {"id": {"type": "string"}, "label": {"type": "string"},
                                 "varies": {"type": "array"}}}
      },
      "winners": {
        "type": "array",
        "maxItems": 50,
        "items": {"type": "object", "required": ["media_id", "asset_id"],
                  "properties": {"media_id": {"type": "string"},
                                 "asset_id": {"type": "integer"}}}
      },
      "open_tests": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/test"}},
      "to_learn": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/test"}}
    }
  },
  "else": {
    "required": ["configured", "message"],
    "additionalProperties": false,
    "properties": {"configured": {"const": false}, "message": {"type": "string"}}
  }
}
